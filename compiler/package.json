{
  "name": "bonescript-compiler",
  "version": "0.5.1",
  "description": "BoneScript compiler — compile .bone system descriptions into complete, runnable Node.js backends",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "bin": {
    "bonec": "dist/cli.js"
  },
  "files": [
    "dist/**/*",
    "src/**/*.ts",
    "!src/test.ts",
    "!src/test_typechecker.ts",
    "LICENSE",
    "README.md"
  ],
  "scripts": {
    "build": "tsc",
    "prepublishOnly": "npm run build",
    "start": "ts-node src/cli.ts",
    "test": "ts-node src/test.ts && ts-node src/test_typechecker.ts",
    "test:jest": "cross-env NODE_OPTIONS=--max-old-space-size=4096 npx jest --runInBand",
    "test:jest:unit": "cross-env NODE_OPTIONS=--max-old-space-size=4096 npx jest --runInBand --testPathPatterns lexer parser typechecker",
    "test:jest:integration": "cross-env NODE_OPTIONS=--max-old-space-size=4096 npx jest --runInBand --testPathPatterns emitter integration",
    "test:jest:watch": "cross-env NODE_OPTIONS=--max-old-space-size=4096 npx jest --runInBand --watch",
    "test:jest:coverage": "cross-env NODE_OPTIONS=--max-old-space-size=4096 npx jest --runInBand --coverage",
    "test:all": "npm test && npm run test:jest:unit && npm run test:jest:integration"
  },
  "keywords": [
    "bonescript",
    "compiler",
    "code-generation",
    "backend",
    "declarative",
    "typescript",
    "postgresql",
    "express",
    "dsl"
  ],
  "license": "MIT",
  "engines": {
    "node": ">=18.0.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Doorman11991/BoneScript.git"
  },
  "homepage": "https://github.com/Doorman11991/BoneScript#readme",
  "bugs": {
    "url": "https://github.com/Doorman11991/BoneScript/issues"
  },
  "devDependencies": {
    "@types/jest": "^30.0.0",
    "@types/node": "18.19.0",
    "cross-env": "^10.1.0",
    "jest": "^30.4.2",
    "ts-jest": "^29.4.9",
    "ts-node": "10.9.2",
    "typescript": "5.3.3"
  }
}
