{
  "name": "bonescript-compiler",
  "version": "0.8.0",
  "description": "BoneScript compiler — compile .bone system descriptions into complete, runnable Node.js backends",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "bin": {
    "bonec": "dist/cli.js"
  },
  "files": [
    "dist/**/*",
    "!dist/test*.js",
    "!dist/test*.js.map",
    "!dist/test*.d.ts",
    "src/**/*.ts",
    "!src/test.ts",
    "!src/test_typechecker.ts",
    "!src/test_nakama.ts",
    "!src/test_sqlite.ts",
    "!src/test_notify.ts",
    "!src/test_react.ts",
    "LICENSE",
    "README.md"
  ],
  "scripts": {
    "build": "tsc",
    "prepare": "npm run build",
    "prepublishOnly": "npm run build",
    "start": "ts-node src/cli.ts",
    "test": "ts-node src/test.ts && ts-node src/test_typechecker.ts && ts-node src/test_nakama.ts && ts-node src/test_sqlite.ts && ts-node src/test_notify.ts && ts-node src/test_react.ts"
  },
  "keywords": [
    "bonescript",
    "compiler",
    "code-generation",
    "backend",
    "declarative",
    "typescript",
    "postgresql",
    "express",
    "dsl"
  ],
  "license": "MIT",
  "engines": {
    "node": ">=18.0.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Doorman11991/BoneScript.git"
  },
  "homepage": "https://github.com/Doorman11991/BoneScript#readme",
  "bugs": {
    "url": "https://github.com/Doorman11991/BoneScript/issues"
  },
  "devDependencies": {
    "@types/node": "18.19.0",
    "ts-node": "10.9.2",
    "typescript": "5.3.3"
  }
}
