{
  "name": "bonescript-vscode",
  "displayName": "BoneScript Language Support",
  "description": "Syntax highlighting, diagnostics, completions, hover, go-to-definition, and outline for BoneScript (.bone) files",
  "version": "0.3.0",
  "publisher": "bonescript",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": ["Programming Languages"],
  "main": "./out/extension.js",
  "contributes": {
    "languages": [
      {
        "id": "bone",
        "aliases": ["BoneScript", "bone"],
        "extensions": [".bone"],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "bone",
        "scopeName": "source.bone",
        "path": "./syntaxes/bone.tmLanguage.json"
      }
    ],
    "commands": [
      {
        "command": "bone.compile",
        "title": "BoneScript: Compile",
        "icon": "$(play)"
      },
      {
        "command": "bone.check",
        "title": "BoneScript: Check (no codegen)",
        "icon": "$(check)"
      },
      {
        "command": "bone.fmt",
        "title": "BoneScript: Format File",
        "icon": "$(symbol-color)"
      },
      {
        "command": "bone.init",
        "title": "BoneScript: Init New Project",
        "icon": "$(new-folder)"
      },
      {
        "command": "bone.showOutput",
        "title": "BoneScript: Show Output",
        "icon": "$(output)"
      }
    ],
    "menus": {
      "editor/title": [
        {
          "command": "bone.compile",
          "when": "resourceExtname == .bone",
          "group": "navigation"
        },
        {
          "command": "bone.check",
          "when": "resourceExtname == .bone",
          "group": "navigation"
        }
      ],
      "editor/context": [
        {
          "command": "bone.compile",
          "when": "resourceExtname == .bone",
          "group": "bone"
        },
        {
          "command": "bone.check",
          "when": "resourceExtname == .bone",
          "group": "bone"
        },
        {
          "command": "bone.fmt",
          "when": "resourceExtname == .bone",
          "group": "bone"
        }
      ]
    },
    "configuration": {
      "title": "BoneScript",
      "properties": {
        "bonescript.compilerPath": {
          "type": "string",
          "default": "bonec",
          "description": "Path to the bonec compiler binary. Defaults to 'bonec' (must be on PATH)."
        },
        "bonescript.outputDir": {
          "type": "string",
          "default": "",
          "description": "Output directory for compiled projects. Defaults to a sibling 'output/' folder."
        },
        "bonescript.autoFormat": {
          "type": "boolean",
          "default": false,
          "description": "Automatically format .bone files on save."
        }
      }
    }
  },
  "scripts": {
    "build": "tsc",
    "watch": "tsc -w",
    "package": "npx vsce package --no-dependencies",
    "install-ext": "code --install-extension bonescript-vscode-0.2.0.vsix"
  },
  "dependencies": {
    "vscode-languageclient": "9.0.1"
  },
  "devDependencies": {
    "@types/vscode": "1.85.0",
    "@types/node": "18.19.0",
    "typescript": "5.3.3",
    "@vscode/vsce": "2.22.0"
  }
}
