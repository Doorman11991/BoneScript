MAX_ATTEMPTS    <- 'max_attempts'   Spacing
BACKOFF         <- 'backoff'        Spacing
INTERVAL        <- 'interval'       Spacing

STRING          <- 'string'         Spacing
UINT            <- 'uint'           Spacing
INT             <- 'int'            Spacing
FLOAT           <- 'float'          Spacing
BOOL            <- 'bool'           Spacing
TIMESTAMP       <- 'timestamp'      Spacing
UUID            <- 'uuid'           Spacing
BYTES           <- 'bytes'          Spacing
MAP             <- 'map'            Spacing
JSON_T          <- 'json'           Spacing
