OWNS            <- 'owns'           Spacing
CONSTRAINTS     <- 'constraints'    Spacing
STATES          <- 'states'         Spacing
AUTH            <- 'auth'           Spacing
RELATION        <- 'relation'       Spacing
INDEX           <- 'index'          Spacing
DERIVED         <- 'derived'        Spacing

REQUIRES        <- 'requires'       Spacing
