LIST            <- 'list'           Spacing
OPTIONAL        <- 'optional'       Spacing
RESULT          <- 'result'         Spacing

TRUE            <- 'true'           Spacing
FALSE           <- 'false'          Spacing

AND             <- 'and'            Spacing
OR              <- 'or'             Spacing
NOT             <- 'not'            Spacing
IN              <- 'in'             Spacing
CONTAINS        <- 'contains'       Spacing
