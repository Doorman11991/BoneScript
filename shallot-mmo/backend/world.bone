// ShallotMMO — BoneScript backend
// Compiled with: bonec compile world.bone
// Frontend: @dylanebert/shallot (WebGPU ECS engine)

system ShallotMMO {

  // ─── Entities ──────────────────────────────────────────────────────────────

  entity Player {
    owns: [
      username:      string,
      email:         string,
      password_hash: string,
      pos_x:         float,
      pos_y:         float,
      pos_z:         float,
      rot_y:         float,
      zone_id:       uuid,
      hp:            uint,
      max_hp:        uint,
      mp:            uint,
      max_mp:        uint,
      xp:            uint,
      level:         uint,
      gold:          uint,
      is_online:     bool
    ]
    constraints: [
      hp <= max_hp,
      mp <= max_mp,
      level >= 1,
      level <= 100,
      max_hp >= 1,
      username.length >= 3
    ]
    states: offline -> online -> in_combat -> online
    relation zone:  belongs_to Zone
    relation guild: belongs_to Guild
  }

  entity Zone {
    owns: [
      name:        string,
      min_level:   uint,
      max_players: uint,
      spawn_x:     float,
      spawn_y:     float,
      spawn_z:     float,
      is_pvp:      bool
    ]
    constraints: [min_level >= 1, max_players >= 1, max_players <= 500]
  }

  entity Item {
    owns: [
      name:         string,
      item_type:    string,
      rarity:       string,
      damage:       uint,
      defense:      uint,
      hp_bonus:     uint,
      mp_bonus:     uint,
      value:        uint,
      is_tradeable: bool
    ]
    constraints: [value >= 0]
  }

  entity InventorySlot {
    owns: [
      quantity:   uint,
      slot_index: uint
    ]
    constraints: [quantity >= 1, slot_index >= 0, slot_index <= 63]
    relation player: belongs_to Player
    relation item:   belongs_to Item
  }

  entity Guild {
    owns: [
      name:         string,
      tag:          string,
      description:  string,
      gold:         uint,
      member_count: uint
    ]
    constraints: [name.length >= 3, tag.length >= 2, tag.length <= 5, member_count >= 1]
  }

  entity Quest {
    owns: [
      title:          string,
      description:    string,
      xp_reward:      uint,
      gold_reward:    uint,
      required_level: uint
    ]
    constraints: [xp_reward >= 0, gold_reward >= 0, required_level >= 1]
  }

  entity QuestProgress {
    owns: [
      progress: uint,
      goal:     uint
    ]
    constraints: [progress <= goal, goal >= 1]
    states: active -> completed | abandoned
    relation player: belongs_to Player
    relation quest:  belongs_to Quest
  }

  // ─── Events ────────────────────────────────────────────────────────────────

  event PlayerMoved {
    payload: { player_id: uuid, x: float, y: float, z: float, rot_y: float, zone_id: uuid }
    delivery: at_least_once
    ttl: 5s
  }

  event PlayerJoinedZone {
    payload: { player_id: uuid, username: string, zone_id: uuid, x: float, y: float, z: float }
    delivery: at_least_once
    ttl: 30s
  }

  event PlayerLeftZone {
    payload: { player_id: uuid, zone_id: uuid }
    delivery: at_least_once
    ttl: 30s
  }

  event CombatResult {
    payload: { attacker_id: uuid, target_id: uuid, damage: uint, attacker_hp: uint, target_hp: uint }
    delivery: at_least_once
    ttl: 10s
  }

  event PlayerDied {
    payload: { player_id: uuid, killer_id: uuid, zone_id: uuid }
    delivery: exactly_once
    ttl: 60s
  }

  event ItemDropped {
    payload: { player_id: uuid, item_id: uuid, zone_id: uuid, x: float, y: float, z: float }
    delivery: at_least_once
    ttl: 300s
  }

  event ChatMessage {
    payload: { sender_id: uuid, channel: string, content: string, zone_id: uuid }
    delivery: at_least_once
    ttl: 60s
  }

  event QuestCompleted {
    payload: { player_id: uuid, quest_id: uuid, xp_gained: uint, gold_gained: uint }
    delivery: exactly_once
    ttl: 300s
  }

  event GuildInviteSent {
    payload: { inviter_id: uuid, invitee_id: uuid, guild_id: uuid }
    delivery: exactly_once
    ttl: 300s
  }

  // ─── Channels (WebSocket — Shallot client connects here) ───────────────────

  channel zone_updates {
    transport:    websocket
    ordering:     causal
    participants: set<Player>
    persistence:  last_50
  }

  channel combat_feed {
    transport:    websocket
    ordering:     causal
    participants: set<Player>
    persistence:  last_20
  }

  channel global_chat {
    transport:    websocket
    ordering:     causal
    participants: set<Player>
    persistence:  last_100
  }

  channel guild_chat {
    transport:    websocket
    ordering:     causal
    participants: set<Player>
    persistence:  last_100
  }

  // ─── Capabilities ──────────────────────────────────────────────────────────

  capability register(username: string, email: string, password_hash: string) {
    requires: [username.length >= 3, email.length >= 5, password_hash.length >= 8]
    effects: [
      username = username,
      email = email,
      password_hash = password_hash,
      hp = 100, max_hp = 100,
      mp = 50,  max_mp = 50,
      level = 1, xp = 0, gold = 100,
      is_online = false,
      pos_x = 0.0, pos_y = 0.0, pos_z = 0.0, rot_y = 0.0
    ]
    sync: transactional
  }

  capability login(player: Player) {
    requires: [player.is_online == false]
    effects:  [player.is_online = true]
    emits:    PlayerJoinedZone
    sync:     transactional
  }

  capability logout(player: Player) {
    requires: [player.is_online == true]
    effects:  [player.is_online = false]
    emits:    PlayerLeftZone
    sync:     transactional
  }

  capability move(player: Player, x: float, y: float, z: float, rot_y: float) {
    requires: [player.is_online == true, player.hp > 0]
    effects: [
      player.pos_x = x,
      player.pos_y = y,
      player.pos_z = z,
      player.rot_y = rot_y
    ]
    emits: PlayerMoved
    sync:  eventual
  }

  capability change_zone(player: Player, zone: Zone) {
    requires: [
      player.is_online == true,
      player.level >= zone.min_level,
      player.hp > 0
    ]
    effects:  [player.zone_id = zone.id]
    emits:    PlayerJoinedZone
    sync:     transactional
  }

  capability attack(attacker: Player, target: Player) {
    requires: [
      attacker.is_online == true,
      target.is_online == true,
      attacker.hp > 0,
      target.hp > 0,
      attacker.zone_id == target.zone_id
    ]
    effects: [
      target.hp -= 10,
      attacker.xp += 5
    ]
    emits:   CombatResult
    sync:    transactional
    timeout: 5s
  }

  capability die(player: Player, killer: Player) {
    requires: [player.hp == 0]
    effects: [
      player.gold -= 10,
      player.xp -= 50
    ]
    emits: PlayerDied
    sync:  transactional
  }

  capability respawn(player: Player, zone: Zone) {
    requires: [player.hp == 0]
    effects: [
      player.hp = player.max_hp,
      player.mp = player.max_mp,
      player.pos_x = zone.spawn_x,
      player.pos_y = zone.spawn_y,
      player.pos_z = zone.spawn_z,
      player.zone_id = zone.id
    ]
    sync: transactional
  }

  capability pick_up_item(player: Player, item: Item, slot: InventorySlot) {
    requires: [
      player.is_online == true,
      player.hp > 0
    ]
    effects:  [slot.quantity += 1]
    sync:     transactional
  }

  capability drop_item(player: Player, slot: InventorySlot) {
    requires: [
      player.is_online == true,
      slot.quantity >= 1
    ]
    effects:  [slot.quantity -= 1]
    emits:    ItemDropped
    sync:     transactional
  }

  capability trade_item(seller: Player, buyer: Player, slot: InventorySlot, item: Item) {
    requires: [
      seller.is_online == true,
      buyer.is_online == true,
      seller.zone_id == buyer.zone_id,
      slot.quantity >= 1,
      item.is_tradeable == true,
      buyer.gold >= item.value
    ]
    effects: [
      slot.quantity -= 1,
      buyer.gold -= item.value,
      seller.gold += item.value
    ]
    sync: transactional
  }

  capability send_chat(player: Player, channel: string, content: string) {
    requires: [
      player.is_online == true,
      content.length >= 1
    ]
    effects: []
    emits:   ChatMessage
    sync:    eventual
  }

  capability create_guild(leader: Player, name: string, tag: string) {
    requires: [
      leader.is_online == true,
      name.length >= 3,
      tag.length >= 2,
      leader.gold >= 500
    ]
    effects: [leader.gold -= 500]
    sync:    transactional
  }

  capability invite_to_guild(inviter: Player, invitee: Player, guild: Guild) {
    requires: [
      inviter.is_online == true,
      invitee.is_online == true
    ]
    effects: []
    emits:   GuildInviteSent
    sync:    eventual
  }

  capability accept_guild_invite(player: Player, guild: Guild) {
    requires: [player.is_online == true]
    effects: [
      player.guild_id = guild.id,
      guild.member_count += 1
    ]
    sync: transactional
  }

  capability complete_quest(player: Player, progress: QuestProgress, quest: Quest) {
    requires: [
      player.is_online == true,
      progress.progress >= progress.goal
    ]
    effects: [
      player.xp += quest.xp_reward,
      player.gold += quest.gold_reward
    ]
    emits: QuestCompleted
    sync:  transactional
  }

  // ─── Flows ─────────────────────────────────────────────────────────────────

  flow player_death_sequence {
    step record_death: die(player, killer)
    step notify_zone:  send_chat(player, "zone", "was slain")
  }

  flow zone_transfer {
    step leave: logout(player)
    step enter: change_zone(player, zone)
  }

  // ─── Stores ────────────────────────────────────────────────────────────────

  store player_sessions {
    engine: redis
  }

  store world_state {
    engine: postgres
  }

}
