# DO NOT COMMIT THIS FILE. It is listed in .gitignore.
# Copy .env.example to .env and fill in real values.

DATABASE_URL=postgresql://postgres:postgres@localhost:5433/simple_shop
REDIS_URL=redis://localhost:6379
# Generate a real secret: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
PORT=3000
NODE_ENV=development
EVENT_MODE=in_process
EVENT_WORKER_INTERVAL_MS=1000

# Comma-separated allowed CORS origins (leave empty to block all cross-origin requests)
ALLOWED_ORIGINS=
