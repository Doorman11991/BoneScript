# InventoryPlatform Environment Variables
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/inventory_platform
REDIS_URL=redis://localhost:6379
JWT_SECRET=change-this-in-production
PORT=3000
NODE_ENV=development

# Event delivery mode: in_process (default) or durable (Postgres-backed outbox)
EVENT_MODE=in_process
EVENT_WORKER_INTERVAL_MS=1000
