// BoneScript: SmartAgenticLLMHarness — Core Data Model
// Entities, stores, and events only.
// Imported by SmartAgenticLLMHarness.bone for the full system.

system SmartAgenticLLMHarnessCore {
  domain: agentic_engineering

  // ─── Entities ──────────────────────────────────────────────────────────────

  entity ReasoningNode {
    owns: [
      provider: string,
      model_id: string,
      role: string,
      capability_tier: uint,
      failure_count: uint,
      success_count: uint,
      avg_latency_ms: float,
      is_available: bool
    ]
    constraints: [
      provider.length in 1..64,
      model_id.length in 1..128,
      role in ["planner", "implementer", "diagnoser", "repairer", "auditor"],
      capability_tier >= 1,
      capability_tier <= 5,
      failure_count >= 0,
      success_count >= 0,
      avg_latency_ms >= 0
    ]
    states: idle -> assigned -> executing -> idle | degraded | evicted
    auth: jwt
    index: [role, capability_tier, is_available]
  }

  entity EngineeringRequest {
    owns: [
      user_id: uuid,
      intent: string,
      request_type: string,
      priority: uint,
      iteration_count: uint,
      max_iterations: uint,
      status: string
    ]
    constraints: [
      intent.length in 1..4096,
      request_type in ["feature", "bugfix", "refactor"],
      priority >= 1,
      priority <= 10,
      iteration_count >= 0,
      max_iterations >= 1,
      max_iterations <= 20,
      status in ["pending", "planning", "implementing", "testing", "diagnosing", "repairing", "auditing", "success", "failure", "aborted"]
    ]
    states: pending -> planning -> implementing -> testing -> diagnosing -> repairing -> auditing -> success | failure | aborted
    index: [user_id, status, priority]
  }

  entity TaskGraph {
    owns: [
      request_id: uuid,
      tasks: json,
      dependency_map: json,
      execution_order: json,
      iteration: uint,
      is_valid: bool,
      task_count: uint
    ]
    constraints: [
      iteration >= 0,
      task_count >= 1
    ]
    states: draft -> validated -> executing -> complete | invalidated
    index: [request_id, iteration]
    relation request: belongs_to EngineeringRequest
  }

  entity CodePatch {
    owns: [
      request_id: uuid,
      task_graph_id: uuid,
      diff: json,
      iteration: uint,
      apply_status: string,
      is_partial: bool,
      patch_type: string
    ]
    constraints: [
      iteration >= 0,
      apply_status in ["pending", "applied", "failed", "rolled_back"],
      is_partial == false,
      patch_type in ["implementation", "repair"]
    ]
    states: pending -> applied -> rolled_back | failed
    index: [request_id, iteration, apply_status]
    relation task_graph: belongs_to TaskGraph
  }

  entity TestResult {
    owns: [
      request_id: uuid,
      patch_id: uuid,
      iteration: uint,
      passed: bool,
      failing_tests: list<string>,
      runtime_logs: string,
      error_traces: string,
      duration_ms: uint
    ]
    constraints: [
      iteration >= 0,
      duration_ms >= 0
    ]
    states: pending -> complete
    index: [request_id, iteration, passed]
    relation patch: belongs_to CodePatch
  }

  entity FailureDiagnosis {
    owns: [
      request_id: uuid,
      test_result_id: uuid,
      iteration: uint,
      failure_class: string,
      root_cause: string,
      affected_components: list<string>,
      fix_strategy: string,
      replan_required: bool
    ]
    constraints: [
      failure_class in ["compilation_failure", "runtime_exception", "logic_failure", "specification_mismatch", "dependency_failure"],
      root_cause.length in 1..4096,
      fix_strategy.length in 1..4096
    ]
    states: draft -> confirmed
    index: [request_id, iteration, failure_class]
    relation test_result: belongs_to TestResult
  }

  entity ExecutionTrace {
    owns: [
      request_id: uuid,
      task_graph_history: json,
      patch_history: json,
      test_history: json,
      failure_chain: json,
      repair_chain: json,
      node_assignment_history: json,
      final_code_state: json,
      terminated_with: string,
      total_iterations: uint,
      total_duration_ms: uint
    ]
    constraints: [
      terminated_with in ["SUCCESS", "FAILURE", "ABORT", "IN_PROGRESS"],
      total_iterations >= 0
    ]
    states: recording -> finalized
    index: [request_id, terminated_with]
    relation request: belongs_to EngineeringRequest
    relation patches: has_many CodePatch
    relation test_results: has_many TestResult
  }

  entity NodePool {
    owns: [
      role: string,
      min_tier: uint,
      max_pool_size: uint,
      current_size: uint
    ]
    constraints: [
      role in ["planner", "implementer", "diagnoser", "repairer", "auditor"],
      min_tier >= 1,
      max_pool_size >= 1,
      current_size >= 0,
      current_size <= max_pool_size
    ]
    states: healthy -> degraded | exhausted
    index: [role, min_tier]
    relation nodes: has_many ReasoningNode
  }

  // ─── Stores ────────────────────────────────────────────────────────────────

  store ReasoningNodeStore {
    engine: postgresql
    schema: {
      id: uuid,
      provider: string,
      model_id: string,
      role: string,
      capability_tier: uint,
      failure_count: uint,
      success_count: uint,
      avg_latency_ms: float,
      is_available: bool,
      state: string,
      created_at: timestamp,
      updated_at: timestamp
    }
    replicas: 2
  }

  store RequestStore {
    engine: postgresql
    schema: {
      id: uuid,
      user_id: uuid,
      intent: string,
      request_type: string,
      priority: uint,
      iteration_count: uint,
      max_iterations: uint,
      status: string,
      state: string,
      created_at: timestamp,
      updated_at: timestamp
    }
    partition: user_id
    replicas: 2
  }

  store TaskGraphStore {
    engine: postgresql
    schema: {
      id: uuid,
      request_id: uuid,
      tasks: json,
      dependency_map: json,
      execution_order: json,
      iteration: uint,
      is_valid: bool,
      task_count: uint,
      state: string,
      created_at: timestamp
    }
    partition: request_id
    replicas: 1
  }

  store PatchStore {
    engine: postgresql
    schema: {
      id: uuid,
      request_id: uuid,
      task_graph_id: uuid,
      diff: json,
      iteration: uint,
      apply_status: string,
      is_partial: bool,
      patch_type: string,
      state: string,
      created_at: timestamp
    }
    partition: request_id
    replicas: 1
  }

  store TestResultStore {
    engine: postgresql
    schema: {
      id: uuid,
      request_id: uuid,
      patch_id: uuid,
      iteration: uint,
      passed: bool,
      failing_tests: json,
      runtime_logs: string,
      error_traces: string,
      duration_ms: uint,
      state: string,
      created_at: timestamp
    }
    partition: request_id
    replicas: 1
  }

  store DiagnosisStore {
    engine: postgresql
    schema: {
      id: uuid,
      request_id: uuid,
      test_result_id: uuid,
      iteration: uint,
      failure_class: string,
      root_cause: string,
      affected_components: json,
      fix_strategy: string,
      replan_required: bool,
      state: string,
      created_at: timestamp
    }
    partition: request_id
    replicas: 1
  }

  store TraceStore {
    engine: postgresql
    schema: {
      id: uuid,
      request_id: uuid,
      task_graph_history: json,
      patch_history: json,
      test_history: json,
      failure_chain: json,
      repair_chain: json,
      node_assignment_history: json,
      final_code_state: json,
      terminated_with: string,
      total_iterations: uint,
      total_duration_ms: uint,
      state: string,
      created_at: timestamp,
      updated_at: timestamp
    }
    replicas: 2
  }

  store NodePoolStore {
    engine: postgresql
    schema: {
      id: uuid,
      role: string,
      min_tier: uint,
      max_pool_size: uint,
      current_size: uint,
      state: string,
      updated_at: timestamp
    }
    replicas: 2
  }

  store NodeSessionStore {
    engine: redis
    schema: {
      node_id: uuid,
      request_id: uuid,
      assigned_role: string,
      expires_at: timestamp
    }
    retention: 2h
  }

  // ─── Events ────────────────────────────────────────────────────────────────

  event RequestAccepted {
    payload: {
      request_id: uuid,
      user_id: uuid,
      request_type: string,
      priority: uint,
      accepted_at: timestamp
    }
    delivery: at_least_once
    ttl: 7d
  }

  event PlanGenerated {
    payload: {
      request_id: uuid,
      task_graph_id: uuid,
      task_count: uint,
      iteration: uint,
      generated_at: timestamp
    }
    delivery: at_least_once
    ttl: 7d
  }

  event PatchApplied {
    payload: {
      request_id: uuid,
      patch_id: uuid,
      patch_type: string,
      iteration: uint,
      applied_at: timestamp
    }
    delivery: exactly_once
    ttl: 30d
  }

  event PatchRolledBack {
    payload: {
      request_id: uuid,
      patch_id: uuid,
      iteration: uint,
      reason: string,
      rolled_back_at: timestamp
    }
    delivery: exactly_once
    ttl: 30d
  }

  event TestsExecuted {
    payload: {
      request_id: uuid,
      test_result_id: uuid,
      iteration: uint,
      passed: bool,
      failing_test_count: uint,
      duration_ms: uint,
      executed_at: timestamp
    }
    delivery: at_least_once
    ttl: 7d
  }

  event FailureClassified {
    payload: {
      request_id: uuid,
      diagnosis_id: uuid,
      failure_class: string,
      replan_required: bool,
      iteration: uint,
      classified_at: timestamp
    }
    delivery: at_least_once
    ttl: 7d
  }

  event NodeRerouted {
    payload: {
      request_id: uuid,
      old_node_id: uuid,
      new_node_id: uuid,
      role: string,
      reason: string,
      rerouted_at: timestamp
    }
    delivery: at_least_once
    ttl: 7d
  }

  event AuditRejected {
    payload: {
      request_id: uuid,
      patch_id: uuid,
      reason: string,
      iteration: uint,
      rejected_at: timestamp
    }
    delivery: exactly_once
    ttl: 30d
  }

  event RunTerminated {
    payload: {
      request_id: uuid,
      outcome: string,
      total_iterations: uint,
      total_duration_ms: uint,
      terminated_at: timestamp
    }
    delivery: exactly_once
    ttl: 90d
  }

  // ─── Policies ──────────────────────────────────────────────────────────────

  policy harness_api {
    rate_limit: 50 per 1m
    access: [admin, orchestrator]
    audit: true
    encryption: both
  }

  policy node_assignment_policy {
    rate_limit: 200 per 1m
    access: [orchestrator]
    audit: true
    encryption: in_transit
  }

  policy trace_access {
    rate_limit: 100 per 1m
    access: [admin, auditor]
    audit: true
    encryption: both
  }

  // ─── Cross-Entity Constraints ──────────────────────────────────────────────

  constraint iteration_ceiling:
    EngineeringRequest.iteration_count <= EngineeringRequest.max_iterations

  constraint single_assignment:
    ReasoningNode.active_request_count <= 1

  constraint immutable_trace:
    ExecutionTrace.total_iterations >= 0

  constraint no_partial_apply:
    CodePatch.iteration >= 0

  constraint pool_capacity:
    NodePool.current_size <= NodePool.max_pool_size
}
