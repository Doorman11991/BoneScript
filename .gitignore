# ─── Dependencies ────────────────────────────────────────────────────────────
node_modules/
.pnp
.pnp.js

# ─── Build outputs ───────────────────────────────────────────────────────────
# compiler/dist/ is now excluded — the compiler is published to npm (bonescript-compiler).
# The LSP references the npm package, not the local dist.
compiler/dist/
lsp/dist/
vscode-ext/out/
compiler/dist-test/
*.js.map
*.d.ts.map

# ─── Compiled JS/DTS artifacts in src/ (should only be in dist/) ─────────────
# These appear when ts-node or tsc emits into the source directory by mistake.
compiler/src/*.js
compiler/src/*.d.ts
compiler/src/**/*.js
compiler/src/**/*.d.ts

# ─── Generated output (bone compile produces this) ───────────────────────────
examples/*/output/
examples/**/.env

# ─── ShallotMMO project (excluded entirely) ──────────────────────────────────
shallot-mmo/

# ─── Test scratch files ───────────────────────────────────────────────────────
examples/test_*.bone
examples/marketplace/run_tests.ts

# ─── VS Code extension package ───────────────────────────────────────────────
*.vsix

# ─── Python scripts used during development ──────────────────────────────────
lsp/src/gen_server*.py
compiler/src/*.py
fix_*.py

# ─── Environment files ───────────────────────────────────────────────────────
.env
.env.local
.env.*.local
# Generated project .env files (contain local DB credentials and secrets)
examples/**/.env
examples/**/output/.env
examples/marketplace/output/.env

# ─── Logs ────────────────────────────────────────────────────────────────────
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# ─── OS files ────────────────────────────────────────────────────────────────
.DS_Store
Thumbs.db
desktop.ini

# ─── Editor files ────────────────────────────────────────────────────────────
.vscode/settings.json
.vscode/launch.json
.idea/
*.swp
*.swo

# ─── TypeScript cache ────────────────────────────────────────────────────────
*.tsbuildinfo

# ─── Coverage ────────────────────────────────────────────────────────────────
coverage/
.nyc_output/

# ─── Temp fix scripts ────────────────────────────────────────────────────────
fix_*.py

# ─── vscode-ext compiled output ──────────────────────────────────────────────
vscode-ext/out/
